{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/assemble-site.mjs",
    "typecheck": "vue-tsc --noEmit",
    "assemble": "node scripts/assemble-site.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "element-plus": "^2.8.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
