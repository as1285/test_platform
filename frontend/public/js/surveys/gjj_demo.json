    "improve_question": "最想优化",
    "improve": [
      { "id": "form", "label": "填写基数" },
      { "id": "preview", "label": "缴存明细" },
      { "id": "verify", "label": "核验说明" },
      { "id": "share", "label": "分享保存" },
      { "id": "pay", "label": "开通去水印" },
      { "id": "other", "label": "其他" }
    ]
  },
  "concerns": [
    {
      "id": "not_official",
      "label": "怕不能当官方公积金证明",
      "explain": "本页是缴存演示样例，不是公积金中心出具的缴存证明或贷款材料。买房、提取、贷款请登录当地公积金 APP 或柜台办理。"
    },
    {
      "id": "center_pull",
      "label": "怕已经连上公积金中心",
      "explain": "演示数据按你填写的基数和比例推算，不会登录或拉取公积金中心账户。余额、连续缴存月数以官方系统为准。"
    },
    {
      "id": "ratio_wrong",
      "label": "怕单位和个人比例不对",
      "explain": "比例按你填写的演示规则计算，各地政策不同。请对照工资条或单位公示再填，改完可重新生成。"
    },
    {
      "id": "watermark",
      "label": "怕不开通看不全",
      "explain": "未开通也可先看演示版式。完整去水印需开通主套餐；演示文件仍不能当官方材料。"
    }
  ],
  "suggestion": {
    "enabled": true,
    "max": 500,
    "placeholder": "基数、明细或开通还有哪里不放心"
  }
