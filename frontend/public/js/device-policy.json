{
  "version": 1,
  "updated": "2026-10-10",
  "description": "First-draft device policy table for inset / mine first-paint / shell px. Mirrors detectors already hard-coded in auth.js + auth-boot.js. Auth does not load this yet — see docs/device-policy.md.",
  "enums": {
    "insetMode": {
      "immersive": "WebView under status bar; keep --app-shell-statusbar-top / --android-status-inset",
      "outer": "System black bar outside WebView; inset often 0 (ColorOS/HyperOS family default)",
      "underlap-black": "Page-owned black status pad (K70 standard mine / preview)",
      "ios-safe-area": "iOS env(safe-area-inset-top) + shell hoist"
    },
    "minePaint": {
      "sm-crop": "Default Android @sm 1180 crop via app-android-mine-e1-sm",
      "plainimg": "Single-layer header img (vivo X90 / iQOO Z9 Turbo+)",
      "true-ratio-lock": "Plain img + locked aspect (K90 Pro Max / Ace Pro / Reno10)",
      "mate60-e1": "Mate60 e1 lock (no padding+neg-margin crop)",
      "underlap-black": "Mine underlap black pad; skip @sm",
      "p40pro-sm": "P40 Pro @sm with aspect-ratio 750/1180 fill",
      "noclip": "Huawei harmony noclip (not for Mate60/P40 special cases)",
      "default": "Generic top-safe shell padding"
    }
  },
  "cssVars": {
    "shellTop": "--app-shell-statusbar-top",
    "androidInset": "--android-status-inset",
    "safeTop": "--safe-top",
    "mineBleed": "--mine-top-bleed"
  },
  "globalExclusions": {
    "androidMineSmFirstPaintNot": [
      "app-android-xiaomi-14pro",
      "app-android-xiaomi-15",
      "app-android-xiaomi-15pro",
      "app-android-huawei-mate60",
      "app-android-huawei-p40pro",
      "app-android-oneplus-acepro",
      "app-android-hinova9se",
      "app-android-redmi-k90promax",
      "app-mine-black-status",
      "app-android-redmi-k70",
      "app-android-xiaomi-13ultra",
      "app-android-redmi-note13-pro",
      "app-android-oppo-reno10",
      "app-android-huawei-matepad115s"
