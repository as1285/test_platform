  "consumeLater": {
    "loadPath": "/js/device-policy.json",
    "matchOrder": "First matching modelCodes / matchNames wins; then apply insetMode + shellPx + minePaint + flags; honor excludeFrom before sibling detectors.",
    "authHooks": [
      "auth-boot.js: applyAndroidMineE1FirstPaint / applyAndroidWhitePageInsetFirstPaint — replace hard-coded regex islands with policy lookup",
      "auth.js: isRedmiK90ProMaxClient / isRedmiK70* / isHuaweiMate60Client / isHuaweiP40* — keep as thin wrappers over policy.match(ua)",
