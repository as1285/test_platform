# 复制为 .env 后按本机修改（.env 已 gitignore，勿提交）
# cp .env.example .env

# 对外站点根地址（无尾斜杠）。用于 iOS 描述文件、二维码回退、后端公开链接等
# 示例：
#   https://lkj.qiyun888.top
#   https://www.geshui.vip
#   http://85.137.247.81
PUBLIC_SITE_URL=https://lkj.qiyun888.top
APP_URL=https://lkj.qiyun888.top

# Git 部署分支：lkj 站与 master 隔离；./scripts/pull-and-deploy.sh 会拉取此分支
DEPLOY_BRANCH=lkj
# DEPLOY_REMOTE=origin

# 额外受信 Host（逗号分隔）。安装包绝对 URL 转同源相对路径时会用到
# 一般可留空：脚本会从 PUBLIC_SITE_URL 自动推导 www/非 www
SITE_TRUSTED_HOSTS=

# Nginx server_name（空格分隔）。默认 _ 表示接受任意 Host（推荐多域名共用镜像）
NGINX_SERVER_NAMES=_

# 本机是否映射 443（直连 HTTPS）。Cloudflare Flexible 源站可设 0
ENABLE_ORIGIN_HTTPS=1

# —— Redis（限流 / OTP；compose 默认服务名 redis）——
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# —— 灾容 / 监控 ——
# MONITOR_ALERT_EMAIL=498771018@qq.com
# 健康巡检自愈（scripts/health-guard.sh，cron */2）
# HEALTH_AUTO_HEAL=1
# HEALTH_DISK_ALERT_PCT=90
# HEALTH_MEM_ALERT_PCT=92
#
# MySQL 热备保留（scripts/backup-mysql.sh）：默认 48h / 最多 36 份
# RETAIN_HOURS=48
# MAX_BACKUPS=36
# BACKUP_MIN_BYTES=4096
#
# 日备/周备/ uploads + 可选腾讯云 COS（scripts/sync-backup-offsite.sh）
# BACKUP_DAILY_KEEP=14
# BACKUP_WEEKLY_KEEP=8
# BACKUP_UPLOADS_KEEP=7
# BACKUP_SUCCESS_MAIL=0
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=your-bucket-1250000000
# COS_REGION=ap-guangzhou
# COS_PREFIX=test_platform/dr

# —— 业务密钥（按需）——
# JWT_SECRET=
# 安装包签名密钥（空则用 JWT_SECRET）；建议生产单独设置
# ASSET_SIGN_SECRET=
# 签名下载链接有效秒数（默认 1800 = 30 分钟）
# ASSET_SIGN_TTL_SEC=1800
# ADMIN_PANEL_USER=admin
# ADMIN_PANEL_PASSWORD=
# ADMIN_ACTIVATION_KEY=
# ADMIN_LOGIN_EMAIL_OTP=0
# ADMIN_OTP_EMAIL=
# REGISTER_STORE_PLAIN_PASSWORD=0
# LOGIN_RATE_PER_IP_MIN=20
# DEVICE_SYNC_THROTTLE_MS=300000

# —— SMTP（监控告警 / 管理端 OTP）——
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# —— 支付宝当面付 ——
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://你的域名/api/payments/alipay/notify
# ALIPAY_RETURN_URL=https://你的域名/purchase.html
# ALIPAY_PRODUCT_TITLE=激活码
# ALIPAY_PRODUCT_AMOUNT=199

# —— 在线客服 AI（OpenAI 兼容）——
# CHAT_AI_API_KEY=
# CHAT_AI_BASE_URL=https://api.deepseek.com
# CHAT_AI_MODEL=deepseek-chat
