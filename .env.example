# 复制为 .env 后按本机修改（.env 已 gitignore，勿提交）
# cp .env.example .env

# 对外站点根地址（无尾斜杠）。用于 iOS 描述文件、二维码回退、后端公开链接等
# 示例：
#   https://lkj.qiyun888.top
#   https://www.geshui.vip
#   http://85.137.247.81
PUBLIC_SITE_URL=https://lkj.qiyun888.top
APP_URL=https://lkj.qiyun888.top

# 仅社保业务对外域名（样例 PDF / 核验页 / 二维码）。空=跟主站 PUBLIC_SITE_URL
# 该域名需解析到本机（或反代 /taxmock、/sbdy_verify.html、/api/public/sbdy-demo）
# SBDY_PUBLIC_ORIGIN=https://sbdy.example.com

# 额外受信 Host（逗号分隔）。安装包绝对 URL 转同源相对路径时会用到
# 一般可留空：脚本会从 PUBLIC_SITE_URL 自动推导 www/非 www
SITE_TRUSTED_HOSTS=

# Nginx server_name（空格分隔）。默认 _ 表示接受任意 Host（推荐多域名共用镜像）
NGINX_SERVER_NAMES=_

# 本机是否映射 443（直连 HTTPS）。Cloudflare Flexible 源站可设 0
ENABLE_ORIGIN_HTTPS=1

# —— 业务密钥（按需）——
# JWT_SECRET=
# ADMIN_PANEL_PASSWORD=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://你的域名/api/payments/alipay/notify
# ALIPAY_RETURN_URL=https://你的域名/purchase.html
# CHAT_AI_API_KEY=

# —— 管理端：同步指定用户到新服务器 ——
# USER_REMOTE_SYNC_ENABLED=1
# USER_REMOTE_SYNC_MODE=ssh
# USER_REMOTE_SYNC_LABEL=新服示例
# USER_REMOTE_SYNC_SSH_HOST=211.101.235.158
# USER_REMOTE_SYNC_SSH_PORT=22
# USER_REMOTE_SYNC_SSH_USER=root
# USER_REMOTE_SYNC_SSH_PASSWORD=
# USER_REMOTE_SYNC_SSH_MYSQL_CMD=docker exec -i test_platform_db mysql -uroot -ppassword --default-character-set=utf8mb4 personal_tax
# 若新服 MySQL 对源站放行，可改用：
# USER_REMOTE_SYNC_MODE=mysql
# USER_REMOTE_SYNC_DB_HOST=
# USER_REMOTE_SYNC_DB_PORT=3306
# USER_REMOTE_SYNC_DB_USER=root
# USER_REMOTE_SYNC_DB_PASSWORD=
# USER_REMOTE_SYNC_DB_DATABASE=personal_tax
